{
  "name": "fuelradar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:start": "bun run scripts/check-local-database.ts",
    "db:stop": "echo 'PostgreSQL is managed by systemd; no project container to stop.'",
    "db:reset": "bun run scripts/reset-local-database.ts",
    "db:test": "bun run scripts/test-local-database.ts",
    "db:test:import": "bun run scripts/verify-mimit-import.ts",
    "db:test:api": "bun run scripts/verify-public-api.ts",
    "db:explain": "bun run scripts/verify-nearby-query-plan.ts",
    "db:push:dry": "SUPABASE_TELEMETRY_DISABLED=1 supabase db push --dry-run",
    "db:push": "SUPABASE_TELEMETRY_DISABLED=1 supabase db push",
    "db:verify": "bun run scripts/check-database-connection.ts",
    "db:fingerprint": "bun run scripts/fingerprint-database-url.ts",
    "import:mimit": "bun run scripts/import-mimit.ts",
    "import:mimit:local": "bun run scripts/import-mimit-local.ts",
    "analyze:mimit": "bun run scripts/analyze-mimit-data.ts",
    "query:nearby": "bun run scripts/query-mimit-nearby.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "next": "16.2.10",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^20",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "supabase": "^2.109.1",
    "typescript": "^5"
  },
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
