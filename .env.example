# Supavisor transaction pooler for Vercel/server runtime (port 6543).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres"
# Direct connection or Supavisor session pooler for migrations (port 5432).
MIGRATION_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
# Native PostgreSQL 17/PostGIS database used only by local DB scripts and tests.
LOCAL_DATABASE_URL="postgresql://fuelradar:fuelradar@127.0.0.1:5432/fuelradar_local"
CRON_SECRET="replace-with-a-long-random-value"
